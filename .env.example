# ── Core AI / ML ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
VOYAGE_API_KEY=your_voyage_api_key_here

# Optional: override default model (default: claude-sonnet-4-6)
# CLAUDE_MODEL=claude-sonnet-4-6

# ── Lead Data ─────────────────────────────────────────────────────────────────
APOLLO_API_KEY=your_apollo_api_key_here

# ── Email (Gmail SMTP + IMAP) ─────────────────────────────────────────────────
# Dedicated LeadGenie Gmail account for sending outreach and receiving replies.
# Use a Gmail App Password (not your account password):
#   Google Account → Security → 2-Step Verification → App Passwords
LEADGENIE_GMAIL=your_leadgenie_gmail@gmail.com
LEADGENIE_GMAIL_PASSWORD=xxxx xxxx xxxx xxxx

# Optional: how often the reply poller checks inbox in seconds (default: 60)
# REPLY_POLL_INTERVAL=60

# ── Scheduling ────────────────────────────────────────────────────────────────
# Optional: Calendly link sent when a lead requests a meeting
# CALENDLY_URL=https://calendly.com/your-link/30min

# Optional: Calendly API (for scheduler.py — not required for core flow)
# CALENDLY_API_TOKEN=your_calendly_api_token
# CALENDLY_ORG_URI=https://api.calendly.com/organizations/your_org_id
